# 数据库配置
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/algorithm_agent

# Redis配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# LLM 提供商配置
# 可选值: deepseek / openai / siliconflow
LLM_PROVIDER=deepseek

# DeepSeek API配置（默认 Key）
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# OpenAI API配置（当 LLM_PROVIDER=openai 时使用）
OPENAI_API_KEY=your_api_key_here

# 硅基流动 API配置（当 LLM_PROVIDER=siliconflow 时使用）
SILICONFLOW_API_KEY=your_api_key_here

# 双 Agent 专用 API Key（优先于默认 Key）
AGENT_A_API_KEY=your_agent_a_api_key_here
AGENT_B_API_KEY=your_agent_b_api_key_here

# Agent 模型配置（可选，默认使用各提供商的推荐模型）
# AGENT_A_MODEL=deepseek-chat
# AGENT_B_MODEL=deepseek-chat

# ChromaDB配置
CHROMA_PERSIST_DIR=./data/chroma_db

# 日志配置
LOG_LEVEL=INFO

# SRT 文件保存配置
# 输出目录（纠错后的SRT文件保存位置）
SRT_OUTPUT_DIR=./output

# 文件命名规则：timestamp（带时间戳）/ corrected（_corrected后缀）/ version（版本号）
SRT_FILENAME_RULE=timestamp

# 是否自动保存文件（true/false）
SRT_AUTO_SAVE=true

# 是否生成纠错报告（true/false）
SRT_GENERATE_REPORT=true

# 报告输出目录
SRT_REPORT_DIR=./reports
